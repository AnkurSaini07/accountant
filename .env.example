# Copy to .env. Bun and docker compose both read it.

# Postgres from compose.yaml
DATABASE_URL=postgres://accountant:accountant@postgres.accountant.orb.local:5432/accountant

# Pocket ID (OIDC) from compose.yaml — generate with: openssl rand -base64 32
POCKET_ID_ENCRYPTION_KEY=

# OIDC client created in the Pocket ID admin UI
APP_URL=http://localhost:3000
OIDC_ISSUER=https://pocket-id.accountant.orb.local
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
