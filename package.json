{
  "name": "accountant",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --use-system-ca --hot src/server/index.ts",
    "start": "bun --use-system-ca src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit --runExternalCode",
    "lint:fix": "bun lint --fix",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "build": "bun scripts/build.ts",
    "migrate": "bun scripts/migrate.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.1.0-dev.20261106.1",
    "unplugin-parcel-macros": "0.2.0"
  },
  "dependencies": {
    "@react-spectrum/s2": "^1.8.2",
    "hono": "4.13.17",
    "oauth4webapi": "^3.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "reylo": "0.7.0",
    "zod": "^4.6.7"
  }
}
