{
  "name": "accountant",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --use-system-ca --hot src/server/index.ts",
    "start": "bun --use-system-ca src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit --runExternalCode",
    "lint:fix": "bun lint --fix",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "build": "bun scripts/build.ts",
    "migrate": "bun scripts/migrate.ts",
    "e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:shots": "bun scripts/docs/shots.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o dist/storybook"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.0",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "storybook": "^10.6.6",
    "typescript": "7.1.0-dev.20261106.1",
    "vite": "^8.3.6",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.42.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.45.0",
    "hono": "4.13.17",
    "jotai": "^3.0.1",
    "oauth4webapi": "^3.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router": "8.5.1",
    "reylo": "0.7.0",
    "zod": "^4.6.7"
  }
}
